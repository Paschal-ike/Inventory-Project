DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://<user>:<password>@<host>:<port>/<db-name>
DATABASE_URL=postgres://hitech_inventory_app:change-me@127.0.0.1:5432/hitech_inventory

# Redis running natively (or in WSL2 on Windows — reach it from Windows via
# the loopback address, same setup as the drone-survey project).
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Separate Redis DB index from the Celery broker above.
REDIS_CACHE_URL=redis://127.0.0.1:6379/1

# Currencies this deployment posts cost-code transactions in. NGN covers the
# 12 Nigerian states; XOF (West African CFA franc) is shared by Togo and
# Benin and only needed once the Phase 3 cross-border rollout is in scope.
SUPPORTED_CURRENCIES=NGN,XOF
DEFAULT_CURRENCY=NGN

RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_API_GENERAL_PER_MIN=100
